# FixSec AI production environment variables.
# Set these in your host's dashboard, or copy to .env.production for
# docker-compose.prod.yml. Never commit the filled-in copy.

ENVIRONMENT=production
DEBUG=false

# Public URLs, no trailing slash
BACKEND_URL=https://your-backend.up.railway.app
FRONTEND_URL=https://your-app.vercel.app

# Railway provides DATABASE_URL automatically. docker-compose.prod.yml builds it
# from POSTGRES_PASSWORD instead.
DATABASE_URL=postgresql://user:password@host:5432/database
POSTGRES_PASSWORD=

# GitHub OAuth App. Callback URL must be <BACKEND_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Required. At least 32 random characters, and the server refuses to start without it.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Stripe. Webhook endpoint: <BACKEND_URL>/billing/webhook
# Events: checkout.session.completed, customer.subscription.updated,
#         customer.subscription.deleted, invoice.payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=

# Optional: error tracking
SENTRY_DSN=

# Optional: email notifications for scheduled scans
SENDGRID_API_KEY=
FROM_EMAIL=noreply@yourdomain.com
