# Copy to backend/.env for local development.

# GitHub OAuth App: https://github.com/settings/developers
# Callback URL: http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Signs sessions and encrypts stored GitHub tokens. Changing it signs everyone out.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-secret-key-here

# SQLite works out of the box. For Postgres:
# DATABASE_URL=postgresql://fixsec:fixsec123@localhost:5432/fixsec
DATABASE_URL=sqlite:///./fixsec.db

# Optional: billing (test-mode keys are fine locally)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_STARTER_PRICE_ID=
# STRIPE_PRO_PRICE_ID=
# STRIPE_TEAM_PRICE_ID=

# Optional: email notifications for scheduled scans
# SENDGRID_API_KEY=
# FROM_EMAIL=noreply@yourdomain.com
